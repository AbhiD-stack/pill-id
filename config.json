{
  "dinov2_model_id": "facebook/dinov2-large",
  "proj_hidden_dim": 1024,
  "proj_embedding_dim": 512,
  "proj_batch_p": 14,
  "proj_batch_k": 4,
  "proj_epochs": 50,
  "proj_lr": 0.001,
  "proj_weight_decay": 0.0001,
  "ce_weight": 0.5,
  "arcface_weight": 0.3,
  "supcon_weight": 0.7,
  "triplet_weight": 0.7,
  "triplet_margin": 0.2,
  "supcon_temperature": 0.07,
  "arcface_s": 30.0,
  "arcface_m": 0.3,
  "run_lora": true,
  "lora_epochs": 10,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": ["query", "key", "value"],
  "lora_lr_backbone": 1e-05,
  "lora_lr_head": 0.0005
}
