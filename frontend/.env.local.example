# Base URL of the FastAPI backend, shared by both the v1 and v2 UIs.
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production / tunneled dev: set to your backend's public HTTPS URL, e.g. a
# Cloudflare Tunnel or your EC2 backend:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_URL=https://your-tunnel-name.trycloudflare.com
