# Backend configuration. Copy to .env and adjust as needed.
# Defaults assume model artifacts + dataset zip live at the repo root.

# MODEL_ARTIFACTS_DIR=/path/to/pill-id
# DATASET_ZIP_PATH=/path/to/pill-id/ePillID_data.zip

# auto | cpu | mps | cuda
DEVICE=auto

# Number of candidate matches returned per prediction.
TOP_K=10

# Embedding-only candidate pool size before OCR imprint re-ranking.
RERANK_POOL_SIZE=30

# Weight of the OCR imprint-match signal in the fused ranking score.
IMPRINT_FUSION_WEIGHT=0.25

# Fused top-1 score below which the response is flagged low_confidence.
LOW_CONFIDENCE_THRESHOLD=0.45

# Comma-separated browser origins allowed to call the API.
# Add your Vercel URL here once the frontend is deployed.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
