# Backend configuration. Copy to .env and adjust as needed.
# Defaults assume model artifacts + dataset zip live at the repo root.

# MODEL_ARTIFACTS_DIR=/path/to/pill-id
# DATASET_ZIP_PATH=/path/to/pill-id/ePillID_data.zip

# Optional second reference-image zip for OTC/DailyMed pill photos, produced by
# notebooks/Backup_New_phase_2_model_2_multi_database.ipynb (cell V3.9). If this
# file doesn't exist yet, the backend still starts fine and serves ePillID-only
# thumbnails; OTC predictions just won't have a reference thumbnail until then.
# OTC_DATASET_ZIP_PATH=/path/to/pill-id/otc_reference_images.zip

# auto | cpu | mps | cuda
DEVICE=auto

# Number of candidate matches returned per prediction.
TOP_K=10

# Comma-separated browser origins allowed to call the API.
# Add your Vercel URL here once the frontend is deployed.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
